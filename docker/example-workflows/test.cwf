            "data": {
                "id": "org.projectcontinuum.core.builtin.Loop",
                "description": "Repeats the nodes inside the box while a CEL condition over flow variables holds.",
                "title": "Loop",
                "subTitle": "Repeat the nodes inside",
                "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\">\n  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99\" />\n</svg>",
                "nodeModel": "org.projectcontinuum.core.builtin.Loop",
                "busy": null,
                "inputs": null,
                "outputs": null,
                "properties": {
                    "condition": "true",
                    "maxIterations": 2,
                    "onLimit": "fail",
                    "onNonBooleanResult": "fail",
                    "check": "after"
                },
                "propertiesSchema": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "condition",
                        "maxIterations",
                        "onLimit",
                        "onNonBooleanResult",
                        "check"
                    ],
                    "properties": {
                        "condition": {
                            "type": "string",
                            "title": "Condition",
                            "description": "Repeat while this CEL expression is true. Read flow variables as vars[\"name\"]; for example vars[\"hasMore\"] == true or vars[\"page\"] < 10 && vars[\"hasMore\"].",
                            "minLength": 1,
                            "maxLength": 2048,
                            "default": "vars[\"hasMore\"] == true"
                        },
                        "maxIterations": {
                            "type": "integer",
                            "title": "Maximum iterations",
                            "description": "The loop never runs more often than this. What happens when the condition still holds at the limit is set by 'When the limit is reached'.",
                            "minimum": 1,
                            "maximum": 10000,
                            "default": 50
                        },
                        "onLimit": {
                            "type": "string",
                            "title": "When the limit is reached",
                            "description": "fail: the loop and the run fail. stop-with-warning: the loop stops with a warning and the nodes after it run with the last iteration's outputs.",
                            "enum": [
                                "fail",
                                "stop-with-warning"
                            ],
                            "default": "fail"
                        },
                        "onNonBooleanResult": {
                            "type": "string",
                            "title": "When the condition is not true or false",
                            "description": "fail: the loop and the run fail when the condition returns another value (for example a string). treat-as-false: the loop stops as if the condition were false and ends with a warning; the nodes after it run with the last iteration's outputs.",
                            "enum": [
                                "fail",
                                "treat-as-false"
                            ],
                            "default": "fail"
                        },
                        "check": {
                            "type": "string",
                            "title": "Check the condition",
                            "description": "after: run the nodes inside at least once, then check after each iteration. before: check before each iteration, so the loop may run zero times.",
                            "enum": [
                                "before",
                                "after"
                            ],
                            "default": "after"
                        }
                    }
                },
                "propertiesUISchema": {
                    "type": "VerticalLayout",
                    "elements": [
                        {
                            "type": "Control",
                            "scope": "#/properties/condition",
                            "options": {
                                "format": "query",
                                "language": "CEL"
                            }
                        },
                        {
                            "type": "Control",
                            "scope": "#/properties/maxIterations"
                        },
                        {
                            "type": "Control",
